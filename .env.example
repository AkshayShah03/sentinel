# ──────────────────────────────────────────────────────────────────────────────
# AI Safety Platform — environment config
# Copy to .env and fill in your values, then run: docker compose up --build
# ──────────────────────────────────────────────────────────────────────────────

# Free LLM API — choose one provider:
#
# Option A: Groq (recommended — completely free, fast)
#   Sign up at https://console.groq.com → API Keys → Create Key
LLM_API_KEY=gsk_YOUR_GROQ_KEY_HERE
LLM_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=llama-3.1-8b-instant
#
# Option B: OpenRouter (free models available)
#   Sign up at https://openrouter.ai → Keys → Create Key
#   Free models: meta-llama/llama-3.2-3b-instruct:free
# LLM_API_KEY=sk-or-YOUR_OPENROUTER_KEY
# LLM_BASE_URL=https://openrouter.ai/api/v1
# JUDGE_MODEL=meta-llama/llama-3.2-3b-instruct:free
#
# Option C: Local Ollama (no key needed, needs Ollama running on host)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# JUDGE_MODEL=llama3.2
